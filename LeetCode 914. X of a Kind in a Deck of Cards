class Solution {
    public boolean hasGroupsSizeX(int[] deck) {
       Map<Integer,Integer>map=new HashMap<>();
       for(int nums:deck){
        map.put(nums,map.getOrDefault(nums,0)+1);
       }
       int gcd=0;
       for(int freq : map.values()){
        gcd=GCD(freq,gcd);
       }
       return gcd>=2;


        
    }
    public int GCD(int a,int b){
        while(b!=0){
            int temp=b;
            b=a%b;
            a=temp;
        }
        return a;
    }
}
